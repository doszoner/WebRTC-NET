+#include <map>
+#include <mutex>
+#include "api/portal_tx_snapshot_v2.h"
+#include "api/portal_tx_channel_internal.h"
+#include "net/dcsctp/socket/dcsctp_socket.h"
+
+namespace portal_backend {
+struct Meta {
+  const void* channel = nullptr;
+  bool policy = false;
+  bool ready = false;
+  unsigned control_kind = 0;
+  uint64_t control_length = 0;
+};
+struct Binding {
+  webrtc_portal_tx_notify_v2 notify;
+  void* user;
+  const void* channel;
+  unsigned control_kind;
+  uint64_t pending_control_length;
+  bool active = false;
+  bool deferred = false;
+  unsigned depth = 0;
+  bool force = false;
+  webrtc_portal_tx_snapshot_v2 previous{};
+  bool has_previous = false;
+  rtc::scoped_refptr<webrtc::DataChannelInterface> channel_keepalive;
+};
+struct SendCapture {
+  const webrtc::DcSctpTransport* transport;
+  int length;
+  bool entered = false;
+  bool seen = false;
+  bool accepted = false;
+};
+std::mutex mutex;
+std::map<const webrtc::DcSctpTransport*, Binding> bindings;
+thread_local const webrtc::DcSctpTransport* captured = nullptr;
+thread_local bool capturing = false;
+thread_local Meta meta;
+thread_local SendCapture* send_capture = nullptr;
+thread_local const ControlPermit* control_permit = nullptr;
+
+void CaptureChannel(const webrtc::DataChannelInterface* channel, bool policy, bool ready,
+                    unsigned kind, uint64_t length) {
+  if (capturing) meta = {channel,policy,ready,kind,length};
+}
+bool AddPending(webrtc_portal_tx_snapshot_v2* value, uint64_t length) {
+  if (length > UINT64_MAX/2 || length == UINT64_MAX ||
+      2*length > UINT64_MAX-value->reservation_bytes ||
+      (length && length+1 > UINT64_MAX-value->reservation_records)) return false;
+  value->reservation_bytes += 2*length;
+  if (length) value->reservation_records += length+1;
+  return true;
+}
+bool AddControlPotential(const webrtc::DcSctpTransport* transport,
+                         webrtc_portal_tx_snapshot_v2* value) {
+  std::lock_guard<std::mutex> lock(mutex);
+  auto found = bindings.find(transport);
+  return found == bindings.end() || AddPending(value, found->second.pending_control_length);
+}
+bool Equal(const webrtc_portal_tx_snapshot_v2& a, const webrtc_portal_tx_snapshot_v2& b) {
+  return a.owned_payload_bytes==b.owned_payload_bytes && a.owned_records==b.owned_records &&
+         a.reservation_bytes==b.reservation_bytes && a.reservation_records==b.reservation_records;
+}
+void Notify(const webrtc::DcSctpTransport* transport, bool destroyed = false) {
+  webrtc_portal_tx_snapshot_v2 value{};
+  int state = destroyed ? 2 : (transport->GetPortalTxOwnership(&value) ? 1 : 0);
+  webrtc_portal_tx_notify_v2 notify = nullptr;
+  void* user = nullptr;
+  rtc::scoped_refptr<webrtc::DataChannelInterface> keepalive;
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    auto found = bindings.find(transport);
+    if (found==bindings.end()) return;
+    Binding& b=found->second;
+    if (!destroyed && b.depth) return;
+    if (state==1 && b.has_previous && !b.force && Equal(value,b.previous)) return;
+    notify=b.notify; user=b.user; b.previous=value; b.has_previous=state==1; b.force=false;
+    if (destroyed) { keepalive=std::move(b.channel_keepalive); bindings.erase(found); }
+  }
+  notify(user,&value,state);
+}
+class Operation {
+ public:
+  explicit Operation(const webrtc::DcSctpTransport* transport):transport_(transport) {
+    std::lock_guard<std::mutex> lock(mutex);
+    auto found=bindings.find(transport);
+    if (found!=bindings.end()) { ++found->second.depth; bound_=true; }
+  }
+  ~Operation() {
+    if (!bound_) return;
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      auto found=bindings.find(transport_);
+      if (found==bindings.end()) return;
+      --found->second.depth;
+    }
+    Notify(transport_);
+  }
+ private:
+  const webrtc::DcSctpTransport* transport_;
+  bool bound_=false;
+};
+bool Probe(void* channel, const webrtc::DcSctpTransport*& transport, Meta& result) {
+  if (!channel || capturing) return false;
+  captured=nullptr; meta={}; capturing=true;
+  static_cast<webrtc::DataChannelInterface*>(channel)->buffered_amount();
+  capturing=false; transport=captured; result=meta; captured=nullptr; meta={};
+  return transport && result.channel && result.policy;
+}
+bool DeferControl(const void* channel) {
+  std::lock_guard<std::mutex> lock(mutex);
+  for (auto& item:bindings) {
+    if (item.second.channel==channel && !item.second.active) {
+      item.second.deferred=true; return true;
+    }
+  }
+  return false;
+}
+void HandshakeChanged(const void* channel) {
+  const webrtc::DcSctpTransport* transport=nullptr;
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    for (auto& item:bindings) if (item.second.channel==channel) {
+      item.second.force=true; transport=item.first; break;
+    }
+  }
+  if (transport) Notify(transport);
+}
+bool SendPermitted(const webrtc::DcSctpTransport* transport,
+                   const webrtc::SendDataParams& params, size_t length) {
+  std::lock_guard<std::mutex> lock(mutex);
+  auto found=bindings.find(transport);
+  if (found==bindings.end()) return true;
+  Binding& b=found->second;
+  if (!b.active) return false;
+  if (params.type==webrtc::DataMessageType::kControl) {
+    if (!control_permit || !control_permit->policy || control_permit->channel!=b.channel ||
+        control_permit->kind!=b.control_kind || control_permit->length!=length ||
+        b.pending_control_length!=length || !length || params.max_rtx_count.has_value() ||
+        params.max_rtx_ms.has_value()) return false;
+    b.pending_control_length=0;
+    return true;
+  }
+  if (!send_capture || send_capture->transport!=transport || send_capture->entered ||
+      length!=static_cast<size_t>(send_capture->length) ||
+      params.type!=webrtc::DataMessageType::kBinary || params.ordered ||
+      !params.max_rtx_count.has_value() || *params.max_rtx_count!=0 ||
+      params.max_rtx_ms.has_value()) return false;
+  send_capture->entered=true;
+  return true;
+}
+void CaptureSend(const webrtc::DcSctpTransport* transport, dcsctp::SendStatus status) {
+  if (send_capture && send_capture->transport==transport) {
+    send_capture->seen=true; send_capture->accepted=status==dcsctp::SendStatus::kSuccess;
+  }
+}
+}  // namespace portal_backend
+
+extern "C" int webrtc_portal_tx_observe_v2(
+    void* channel,webrtc_portal_tx_notify_v2 notify,void* user,webrtc_portal_tx_snapshot_v2* out) {
+  using namespace portal_backend;
+  const webrtc::DcSctpTransport* transport=nullptr; Meta value;
+  if (!out || !Probe(channel,transport,value)) return 0;
+  bool exists=false;
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    auto found=bindings.find(transport);
+    if (found!=bindings.end()) {
+      if (found->second.channel!=value.channel ||
+          (notify && (found->second.notify!=notify || found->second.user!=user))) return 0;
+      exists=true;
+    }
+  }
+  if (!transport->GetPortalTxOwnership(out)) return 0;
+  if (exists) return 1;
+  if (!AddPending(out,value.control_length)) return 0;
+  if (!notify) return 1;
+  std::lock_guard<std::mutex> lock(mutex);
+  if (bindings.size()>=64) return 0;
+  Binding b{notify,user,value.channel,value.control_kind,value.control_length};
+  b.previous=*out; b.has_previous=true;
+  b.channel_keepalive=const_cast<webrtc::DataChannelInterface*>(
+      static_cast<const webrtc::DataChannelInterface*>(value.channel));
+  bindings.emplace(transport,b);
+  return 1;
+}
+
+extern "C" int webrtc_portal_tx_activate_v2(void* channel,uint64_t bytes,uint64_t records) {
+  using namespace portal_backend;
+  if (!channel || !bytes || bytes>65536 || !records) return -1;
+  const webrtc::DcSctpTransport* transport=nullptr; Meta meta;
+  if (!Probe(channel,transport,meta)) return -1;
+  webrtc_portal_tx_snapshot_v2 snapshot{};
+  if (!transport->GetPortalTxOwnership(&snapshot)) return -1;
+  if (snapshot.reservation_bytes>bytes || snapshot.reservation_records>records) return 0;
+  bool resume=false;
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    auto found=bindings.find(transport);
+    if (found==bindings.end() || found->second.channel!=meta.channel) return -1;
+    if (!found->second.active) {
+      found->second.active=true;
+      resume=found->second.deferred;
+      found->second.deferred=false;
+    }
+  }
+  // Retry only an already-deferred control; preserve the SDK's original callback ordering.
+  if (resume) ScheduleChannelResume(meta.channel);
+  return 1;
+}
+
+extern "C" int webrtc_portal_tx_try_send_v2(
+    void* channel,const void* data,int length,uint64_t bytes,uint64_t records) {
+  using namespace portal_backend;
+  if (!channel || !data || length<1 || length>1400 || send_capture ||
+      !bytes || bytes>65536 || !records) return -1;
+  rtc::scoped_refptr<webrtc::DataChannelInterface> owned(
+      static_cast<webrtc::DataChannelInterface*>(channel));
+  const webrtc::DcSctpTransport* transport=nullptr; Meta meta;
+  if (!Probe(channel,transport,meta)) return -1;
+  if (owned->state()==webrtc::DataChannelInterface::kClosing ||
+      owned->state()==webrtc::DataChannelInterface::kClosed) return -1;
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    auto found=bindings.find(transport);
+    if (found==bindings.end() || found->second.channel!=meta.channel) return -1;
+    if (!found->second.active || !meta.ready) return 0;
+  }
+  webrtc_portal_tx_snapshot_v2 snapshot{};
+  if (!transport->GetPortalTxOwnership(&snapshot)) return -1;
+  const uint64_t added_bytes=static_cast<uint64_t>(length)*2;
+  const uint64_t added_records=static_cast<uint64_t>(length)+1;
+  if (snapshot.reservation_bytes>bytes || added_bytes>bytes-snapshot.reservation_bytes ||
+      snapshot.reservation_records>records || added_records>records-snapshot.reservation_records) return 0;
+  SendCapture capture{transport,length}; send_capture=&capture;
+  const bool accepted=owned->Send(webrtc::DataBuffer(
+      rtc::CopyOnWriteBuffer(static_cast<const uint8_t*>(data),length),true));
+  send_capture=nullptr;
+  return accepted && capture.seen && capture.accepted &&
+         owned->state()==webrtc::DataChannelInterface::kOpen ? 1 : -1;
+}
