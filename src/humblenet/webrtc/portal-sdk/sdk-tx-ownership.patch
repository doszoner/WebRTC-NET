+#ifndef NET_DCSCTP_PUBLIC_TX_OWNERSHIP_H_
+#define NET_DCSCTP_PUBLIC_TX_OWNERSHIP_H_
+#include <cstdint>
+#include <limits>
+namespace dcsctp {
+struct TxOwnership {
+  uint64_t payload_bytes = 0;
+  uint64_t records = 0;
+  uint64_t reservation_bytes = 0;
+  uint64_t reservation_records = 0;
+  bool valid = true;
+  void AddCounter(uint64_t& value, uint64_t add) {
+    if (add > std::numeric_limits<uint64_t>::max() - value) { valid = false; return; }
+    value += add;
+  }
+  void AddOwned(uint64_t bytes, uint64_t count) {
+    AddCounter(payload_bytes, bytes); AddCounter(records, count);
+  }
+  void AddPotential(uint64_t bytes, uint64_t count) {
+    AddCounter(reservation_bytes, bytes); AddCounter(reservation_records, count);
+  }
+  void Add(uint64_t bytes, uint64_t count) { AddOwned(bytes, count); AddPotential(bytes, count); }
+  void Merge(const TxOwnership& other) {
+    valid = valid && other.valid;
+    AddOwned(other.payload_bytes, other.records);
+    AddPotential(other.reservation_bytes, other.reservation_records);
+  }
+};
+}
+#endif
